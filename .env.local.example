# Copy this file to .env.local and fill in the values.

# MongoDB Atlas connection string.
# Atlas dashboard -> Connect -> Drivers -> "Add your connection string into your application code".
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB database name (will be created if it does not exist).
MONGODB_DB=ecf_roster

# Random secret for signing session cookies. Generate one with:
#   openssl rand -hex 32
# or paste any long random string (>= 32 chars).
SESSION_SECRET=

# (Optional) Telegram bot config can also be set here, or in the Admin -> Settings page.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Public base URL of the deployed app (used to build password-reset links).
# For local dev: http://localhost:3000
# For Vercel: https://<your-project>.vercel.app  (set this in Vercel env vars too)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Full Vercel deploy guide (env keys, Atlas allowlist, signup, password resets):
# see DEPLOY.md
